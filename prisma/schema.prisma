// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

model About {
  id          Int    @id @default(autoincrement())
  picture     String
  job         String
  description String
}

model Category {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  color       String
  svg         String
  lottie      Json
  draft       Boolean @default(false)
  order       Int

  projects ProjectCategories[]
}

model ProfessionalCareer {
  id           Int       @id @default(autoincrement())
  job          String
  type         String
  organization String
  place        String
  start        DateTime
  end          DateTime?
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  preview     String
  title       String
  description String
  content     Json
  draft       Boolean @default(false)

  categories ProjectCategories[]
}

model ProjectCategories {
  id         Int      @id @default(autoincrement())
  projectId  Int
  categoryId Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([projectId, categoryId])
}

model SchoolCareer {
  id     Int       @id @default(autoincrement())
  name   String
  school String
  place  String
  start  DateTime
  end    DateTime?
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  email      String    @unique
  password   String
  role       Role      @default(USER)
  resetToken String?
  resetAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
